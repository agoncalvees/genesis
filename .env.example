# Esqueleto documental: nomes definitivos verificados na fase 00.
# Convex public endpoint (convention confirmed in Convex TanStack Start quickstart; VITE_* is browser-visible)
VITE_CONVEX_URL=
# Server only. Never prefix secrets with VITE_.
OPENROUTER_API_KEY=
AI_MODEL_PRIMARY=
AI_MODEL_FALLBACK=
# AI server functions are OFF unless AI_ENDPOINTS_ENABLED=1.
# In production they also require header x-genesis-ai-token == AI_ACCESS_TOKEN.
AI_ENDPOINTS_ENABLED=
AI_ACCESS_TOKEN=
# Opt-in real provider test (spends credits): GENESIS_REAL_AI=1 bun run test
# Optional independent provider variables added only when selected.
